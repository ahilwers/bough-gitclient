<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>CFBundlePackageType</key>
            <string>APPL</string>
        <key>CFBundleName</key>
            <string>GitMorrow</string>
        <key>CFBundleExecutable</key>
            <string>GitMorrow</string>
        <key>CFBundleIdentifier</key>
            <string>net.hilwers.bough</string>
        <key>CFBundleVersion</key>
            <string>0.1.0</string>
        <key>CFBundleGetInfoString</key>
            <string>A beautiful Git GUI client</string>
        <key>CFBundleShortVersionString</key>
            <string>0.1.0</string>
        <key>CFBundleIconFile</key>
            <string>icons</string>
        <key>LSMinimumSystemVersion</key>
            <string>12.0.0</string>
        <key>NSHighResolutionCapable</key>
            <string>true</string>
        <key>NSHumanReadableCopyright</key>
            <string>Copyright 2026</string>
        <!-- Sparkle 2 auto-update -->
        <key>SUFeedURL</key>
        <string>https://updates.bough.app/appcast.xml</string>
        <key>SUPublicEDKey</key>
        <string>REPLACE_WITH_EDDSA_PUBLIC_KEY</string>
        <key>SUAllowsAutomaticUpdates</key>
        <true/>
        <key>SUEnableAutomaticChecks</key>
        <true/>
        <key>SUScheduledCheckInterval</key>
        <integer>86400</integer>
    </dict>
</plist>
