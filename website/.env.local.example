# ── Stripe ──────────────────────────────────────────────────────────────────
# Test keys (safe to use for local dev — no real charges):
#   sk_test_... → Stripe Dashboard → Developers → API keys
#   price_...   → Stripe Dashboard → Products → create a product → copy price ID
#
# Live keys (production only — never commit):
#   sk_live_... / price_live_...

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...

# ── Base URL ─────────────────────────────────────────────────────────────────
# Local dev:
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Production:
# NEXT_PUBLIC_BASE_URL=https://boughapp.com
