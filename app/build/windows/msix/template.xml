<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="gitmorrow"
        Arguments=""
        InstallLocation="C:\Program Files\GitMorrow">
    </Installer>
    <PackageInformation
        PackageName="GitMorrow"
        PackageDisplayName="GitMorrow"
        PublisherName="CN=Achim Hilwers"
        PublisherDisplayName="Achim Hilwers"
        Version="0.1.0.0"
        PackageDescription="A beautiful Git GUI client">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="net.hilwers.bough"
                Description="A beautiful Git GUI client"
                DisplayName="GitMorrow"
                ExecutableName="gitmorrow"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>GitMorrow</DisplayName>
            <PublisherDisplayName>Achim Hilwers</PublisherDisplayName>
            <Description>A beautiful Git GUI client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="gitmorrow.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
